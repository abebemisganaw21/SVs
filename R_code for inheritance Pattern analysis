# ============================================================================

cat("\n========================================\n")
cat("ANALYSIS COMPLETE!\n")
cat("========================================\n")
cat("\nOutput files saved to:\n")
cat("  - SV_Figures/ (all figures)\n")
cat("  - SV_Tables/ (CSV files)\n")
cat("  - SV_Excel/ (Excel workbook)\n")

